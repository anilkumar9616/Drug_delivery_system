# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=../../logs

# Delivery Configuration
SLA_HOURS=48
DELAYED_DELIVERY_ALERT_HOURS=24
DELIVERY_ATTEMPT_THRESHOLD=3
