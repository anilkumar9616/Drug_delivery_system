# Delivery Service Configuration

# Service Port
DELIVERY_SERVICE_PORT=5006

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drug_delivery_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
